{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug folder (all *.c)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/a.out",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "build folder (all *.c)",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Don't stall asking to download debug info",
                    "text": "-interpreter-exec console \"set debuginfod enabled off\"",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug folder (all *.c) + sanitizers",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/a.asan.out",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [
                {
                    "name": "ASAN_OPTIONS",
                    "value": "abort_on_error=1:detect_leaks=1"
                },
                {
                    "name": "UBSAN_OPTIONS",
                    "value": "print_stacktrace=1"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "build folder (all *.c) + sanitizers",
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "text": "-interpreter-exec console \"set debuginfod enabled off\"",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug folder (make)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/.debug.bin",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "build folder (make)",
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "text": "-interpreter-exec console \"set debuginfod enabled off\"",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug single file only",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "build single file only",
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "text": "-interpreter-exec console \"set debuginfod enabled off\"",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
